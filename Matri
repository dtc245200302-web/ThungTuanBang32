    ROUND(INDEX_LENGTH / NULLIF(DATA_LENGTH, 0), 2) AS Index_vs_Data_Ratio
FROM information_schema.TABLES
WHERE TABLE_SCHEMA = 'quickfeed_db'
  AND TABLE_NAME = 'Posts';

